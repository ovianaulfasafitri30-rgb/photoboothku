body {
  background: #3b2f2f;
  color: #f5e6d3;
  font-family: 'Arial', sans-serif;
  text-align: center;
}

.container {
  margin-top: 20px;
}

video {
  width: 250px;
  border-radius: 10px;
  border: 3px solid #d2b48c;
}

button {
  margin-top: 10px;
  padding: 10px 20px;
  background: #6b4f4f;
  color: white;
  border: none;
  border-radius: 8px;
  cursor: pointer;
}

#countdown {
  font-size: 40px;
  margin: 10px;
}

.photo-strip {
  background: #2b1f1f;
  padding: 15px;
  display: inline-block;
  border-radius: 10px;
  margin-top: 20px;
}

.photo-strip img {
  display: block;
  width: 200px;
  margin: 10px auto;
  border-radius: 8px;
}
